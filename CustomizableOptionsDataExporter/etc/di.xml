<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Enrich the products feed with the ac_customizable_options attribute -->
    <type name="Magento\DataExporter\Export\Processor">
        <plugin name="data_exporter_add_customizable_options"
                type="Magento\CustomizableOptionsDataExporter\Plugin\AddCustomizableOptionsToProductFeed"/>
    </type>

    <!-- Register ac_customizable_options as an opaque JSON (OBJECT) system attribute -->
    <type name="Magento\CatalogDataExporter\Service\SystemAttributeRegistrar">
        <arguments>
            <argument name="configurationMap" xsi:type="array">
                <item name="ac_customizable_options" xsi:type="array">
                    <item name="properties" xsi:type="array">
                        <item name="label" xsi:type="string">AC Customizable Options</item>
                        <item name="visible_on_front" xsi:type="boolean">true</item>
                    </item>
                    <item name="exporterOverrides" xsi:type="array">
                        <item name="dataType" xsi:type="string">OBJECT</item>
                        <item name="visible" xsi:type="boolean">true</item>
                        <item name="visibleInSearch" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
